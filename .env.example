# CONFIGURACION - Mi Panel Academico
#
# Copia este archivo como .env para desarrollo local.
# No pegues secretos reales en el repo.

# Aplicacion
VITE_APP_VERSION=1.0.0
VITE_PUBLIC_APP_URL=https://pps-psico.github.io

# Backend principal (obligatorio)
VITE_SUPABASE_URL=https://xxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Monitoreo y analitica (opcionales)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_ENABLE_MONITORING_IN_DEV=false
# Site key público de Cloudflare Turnstile para proteger recuperación de acceso.
# El secret correspondiente se configura como TURNSTILE_SECRET_KEY en Supabase.
# VITE_TURNSTILE_SITE_KEY=

# Notificaciones
# VITE_VAPID_PUBLIC_KEY=BI...
# VITE_ONESIGNAL_APP_ID=
# VITE_ONESIGNAL_SAFARI_WEB_ID=

# Integraciones (opcionales)
# Hermes (agente IA interno): YA NO se configura en el frontend.
# El token es un secreto server-side de la Edge Function `hermes-proxy`:
#   npx supabase secrets set HERMES_INTERNAL_TOKEN=<token> --project-ref qxnxtnhtbpsgzprqtrjl
#   npx supabase secrets set HERMES_API_URL=https://pps-hermes.n8n-blas.com.ar --project-ref qxnxtnhtbpsgzprqtrjl
# Cualquier variable VITE_* termina en el bundle publico: nunca poner secretos aca.
# Todoist: token de API para la sincronizacion de tareas. Idealmente proxyear via
# Edge Function para no exponerlo en el bundle del cliente.
# VITE_TODOIST_TOKEN=

# Nota:
# GEMINI_API_KEY y otros secretos server-side deben configurarse en Supabase
# Edge Functions, no como variables VITE_ del frontend.
